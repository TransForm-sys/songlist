# 复制成 /opt/songlist/app.env 后 chmod 600，按需修改。
# 这里的值会覆盖代码里的默认值，改完要 systemctl restart songlist。

# ---- 监听 ----
PORT=5181
# 只监听本机，由 Nginx 反向代理对外；不要直接暴露到公网
HOST=127.0.0.1

# ---- 数据 ----
# SQLite 数据库、备份、上传的图片都在这里，**这是唯一需要备份的目录**
DATA_DIR=/opt/songlist/data
# 前端构建产物目录（pnpm build 的产物）
STATIC_DIR=/opt/songlist/app/dist
# 保留多少份备份（超出的自动删掉最旧的）
BACKUP_KEEP=60

# ---- 管理员账号 ----
ADMIN_USER=admin
# 只在本机首次启动（数据库里还没有用户）时生效，用来建账号。
# 登录后请到「账号安全」里改密码，改完就把这一行删掉/注释掉并重启 —— 密码只以
# scrypt 哈希存在数据库里，服务器上不需要长期保留明文。
# ADMIN_PASSWORD=换成你自己的强密码
#
# 也可以只给哈希（用 `node scripts/reset-password.mjs --hash-only '密码'` 生成）：
# ADMIN_PASSWORD_HASH=scrypt$16384$8$1$...

# ---- 安全 ----
# 全站 HTTPS 时设为 1（cookie 加 Secure）。纯 http 访问时必须为 0，否则登录不上。
COOKIE_SECURE=1
# 默认信任 X-Forwarded-For（Nginx 反代场景）。如果服务直接暴露给公网，设成 0。
TRUST_PROXY=1

# ---- 日志 ----
# info：打印每个 API 请求；silent：不打印（推荐生产用 silent，看 journal 里的报错就够）
LOG_LEVEL=silent
